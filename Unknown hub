local CombatTab = Window:MakeTab("Combat")
local Combat = CombatTab:AddSection()

local AimbotEnabled = false
local AimFOV = 100
local AimSmooth = 1
local AimPart = "Head"
local FOVCircle = Drawing.new("Circle")
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Thickness = 1
FOVCircle.NumSides = 30
FOVCircle.Filled = false
FOVCircle.Transparency = 1

local function GetClosest()
    local target, dist = nil, AimFOV
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local pos, vis = Camera:WorldToViewportPoint(v.Character[AimPart].Position)
            if vis then
                local mag = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(pos.X, pos.Y)).Magnitude
                if mag < dist then target = v dist = mag end
            end
        end
    end
    return target
end

Combat:AddToggle({
    Name = "Aimbot Enabled",
    Default = false,
    Callback = function(v)
        AimbotEnabled = v
        while AimbotEnabled do
            local t = GetClosest()
            if t then
                local tPos = t.Character[AimPart].Position
                local current = Camera.CFrame
                local target = CFrame.new(Camera.CFrame.Position, tPos)
                Camera.CFrame = current:Lerp(target, AimSmooth)
            end
            task.wait()
        end
    end
})

Combat:AddToggle({
    Name = "Show FOV",
    Default = false,
    Callback = function(v) FOVCircle.Visible = v end
})

