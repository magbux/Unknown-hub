local Window = Borealis.new("Unknown Hub Ultimate")

local ESPConfig = {
    Enabled = false,
    Boxes = false,
    Names = false,
    Distance = false,
    Health = false,
    Tracers = false,
    TeamCheck = false,
    Color = Color3.fromRGB(255, 0, 0),
    FontSize = 14
}

local function DrawLine() local l = Drawing.new("Line") l.Visible = false l.From = Vector2.new(0, 0) l.To = Vector2.new(1, 1) l.Color = Color3.fromRGB(255, 255, 255) l.Thickness = 1 l.Transparency = 1 return l end
local function DrawBox() local b = Drawing.new("Square") b.Visible = false b.Color = Color3.fromRGB(255, 0, 0) b.Thickness = 1 b.Transparency = 1 b.Filled = false return b end
local function DrawText() local t = Drawing.new("Text") t.Visible = false t.Center = true t.Outline = true t.Font = 2 t.Size = 14 t.Color = Color3.fromRGB(255, 255, 255) return t end

local function AddESP(player)
    local Box = DrawBox()
    local Name = DrawText()
    local Dist = DrawText()
    local HealthBar = Drawing.new("Line") HealthBar.Thickness = 2
    local Tracer = DrawLine()
    
    local function Updater()
        local c = RunService.RenderStepped:Connect(function()
            if not player.Parent or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") or not ESPConfig.Enabled then
                Box.Visible = false Name.Visible = false Dist.Visible = false Tracer.Visible = false HealthBar.Visible = false
                if not player.Parent then Box:Remove() Name:Remove() Dist:Remove() Tracer:Remove() HealthBar:Remove() return end
                return
            end
            
            local Root = player.Character.HumanoidRootPart
            local Hum = player.Character:FindFirstChild("Humanoid")
            local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)
            local DistVal = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - Root.Position).Magnitude) or 0
            
            if ESPConfig.TeamCheck and player.Team == LocalPlayer.Team then
                Box.Visible = false Name.Visible = false Dist.Visible = false Tracer.Visible = false HealthBar.Visible = false return
            end
            
            if OnScreen then
                local Size = (Camera:WorldToViewportPoint(Root.Position - Vector3.new(0, 3, 0)).Y - Camera:WorldToViewportPoint(Root.Position + Vector3.new(0, 2.6, 0)).Y) / 2
                local BoxSize = Vector2.new(math.floor(Size * 1.5), math.floor(Size * 2))
                local BoxPos = Vector2.new(math.floor(Pos.X - Size * 1.5 / 2), math.floor(Pos.Y - Size * 2 / 2))
                
                if ESPConfig.Boxes then
                    Box.Size = BoxSize
                    Box.Position = BoxPos
                    Box.Visible = true
                    Box.Color = ESPConfig.Color
                else Box.Visible = false end
                
                if ESPConfig.Names then
                    Name.Position = Vector2.new(BoxPos.X + BoxSize.X / 2, BoxPos.Y - 20)
                    Name.Text = player.Name
                    Name.Color = ESPConfig.Color
                    Name.Visible = true
                else Name.Visible = false end
                
                if ESPConfig.Distance then
                    Dist.Position = Vector2.new(BoxPos.X + BoxSize.X / 2, BoxPos.Y + BoxSize.Y + 5)
                    Dist.Text = math.floor(DistVal) .. " studs"
                    Dist.Color = Color3.fromRGB(255, 255, 255)
                    Dist.Visible = true
                else Dist.Visible = false end
                
                if ESPConfig.Tracers then
                    Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    Tracer.To = Vector2.new(Pos.X, Pos.Y)
                    Tracer.Color = ESPConfig.Color
                    Tracer.Visible = true
                else Tracer.Visible = false end

                if ESPConfig.Health and Hum then
                    local HealthPerc = Hum.Health / Hum.MaxHealth
                    HealthBar.From = Vector2.new(BoxPos.X - 5, BoxPos.Y + BoxSize.Y)
                    HealthBar.To = Vector2.new(BoxPos.X - 5, BoxPos.Y + BoxSize.Y - (BoxSize.Y * HealthPerc))
                    HealthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), HealthPerc)
                    HealthBar.Visible = true
                else HealthBar.Visible = false end
            else
                Box.Visible = false Name.Visible = false Dist.Visible = false Tracer.Visible = false HealthBar.Visible = false
            end
        end)
    end
    Updater()
end

